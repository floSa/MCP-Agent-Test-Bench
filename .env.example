# Copier en .env puis adapter. Le .env n'est pas suivi par git.

# --- LLM : service central LLM-Service (API OpenAI via LiteLLM) -------------
# Depuis un conteneur sur le réseau Docker « llm-net » : http://llm-central:8080/v1
# Depuis l'hôte (uv run ...)                            : http://127.0.0.1:8080/v1
LLM_BASE_URL=http://llm-central:8080/v1
# Nom de modèle côté LLM-Service : "chat" (Qwen3.5-4B, réflexion + vision).
LLM_MODEL=chat
# Clé du service : valeur de LITELLM_MASTER_KEY dans le .env de LLM-Service
# (de la forme sk-local-...). À mettre uniquement dans .env, jamais ici.
LLM_API_KEY=
# Paramètres JSON ajoutés à chaque requête. La réflexion est active par défaut
# sur "chat" ; pour un agent à outils on la coupe (réponses plus rapides).
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Port publié sur l'hôte pour l'API de l'agent (8080 est pris par LLM-Service).
# AGENT_PORT=8090
