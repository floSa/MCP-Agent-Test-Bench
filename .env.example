# Copier en .env puis adapter.

# --- LLM (API compatible OpenAI : Ollama OU vLLM) ---------------------------
# Ollama central : http://ollama-central:11434/v1
# vLLM           : http://<nom-du-service-vllm>:8000/v1
LLM_BASE_URL=http://ollama-central:11434/v1
LLM_MODEL=gemma4:e4b
# Ollama ignore la clé ; vLLM l'exige seulement s'il tourne avec --api-key.
LLM_API_KEY=inutile

# --- Uniquement pour `make up-local` (Ollama embarqué) ----------------------
# Dossier hôte partagé entre projets pour les modèles (évite de les retélécharger).
# OLLAMA_MODELES=/chemin/vers/.ollama
